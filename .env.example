# Supabase — مصادقة الأدمن (Authentication → Users) + مفتاح القراءة العام
# نفس القيم متظبطة في Vercel → Project Settings → Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Server-only. Needed for scheduled backups and Web Push subscriptions; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Public URL on production — used for canonical links, sitemap, and SEO.
NEXT_PUBLIC_SITE_URL=https://your-store.example

# Cloudinary — رفع صور المنتجات واللوجو والواجهة
# أنشئ Unsigned Upload Preset مقيّداً بالصور والحجم الأقصى 5MB
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=store-catalog

# Web Push — أنشئ VAPID keys عبر: npx web-push generate-vapid-keys
# المفتاح العام فقط مسموح للمتصفح؛ الباقي Server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:owner@your-store.example

# Vercel Cron يستدعي النسخة اليومية تلقائياً. ضع قيمة طويلة وعشوائية.
CRON_SECRET=replace-with-a-long-random-secret

# Upstash Redis — مخزن مشترك لحدود المعدّل (rate limiting).
# من غيره العدّ بيحصل في ذاكرة كل انستانس لوحده، يعني على Vercel الحد الفعلي
# = الحد × عدد الانستانسات. اختياري محلياً، مفضّل جداً في الإنتاج.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-rest-token

# للتطوير المحلي فقط: لو متغيرات Supabase مش موجودة البيانات بتتحفظ في ملف
# DATABASE_FILE=/absolute/path/to/store.json
